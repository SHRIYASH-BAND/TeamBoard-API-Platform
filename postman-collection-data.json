            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Query - With Token (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/kb/query/",
              "host": ["{{base_url}}"],
              "path": ["api", "kb", "query", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search\": \"select_related\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Has count and results\", function () {",
                  "  pm.expect(json).to.have.property('count');",
                  "  pm.expect(json).to.have.property('results');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Query - No Results (200, count=0)",
          "request": {
            "method": "POST",
            "header": [
