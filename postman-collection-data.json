              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test(\"Zero results\", function () {",
                  "  pm.expect(json.count).to.eql(0);",
                  "  pm.expect(json.results).to.be.an('array').that.is.empty;",
                  "});"
                ]
              }
            }
          ]
        }
