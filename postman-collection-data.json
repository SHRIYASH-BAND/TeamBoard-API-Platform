  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Success (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.environment.set(\"access_token\", json.access);",
                  "pm.environment.set(\"api_key\", json.api_key);",
                  "pm.test(\"Token & API key present\", function () {",
                  "  pm.expect(json.access).to.be.a('string');",
                  "  pm.expect(json.api_key).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
